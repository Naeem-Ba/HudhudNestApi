<Project Sdk="Microsoft.NET.Sdk">

	<!--
    PropertyApi.Tests/PropertyApi.Tests.csproj
    مشروع الاختبارات — يُضاف إلى الـ Solution بأمر:
    dotnet sln PropertyApi.sln add PropertyApi.Tests/PropertyApi.Tests.csproj
  -->

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- تحسين: أوقف رسائل التشخيص الزائدة أثناء الاختبار -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- ── حزم الاختبار ──────────────────────────────────────── -->
	<ItemGroup>
		<!-- xUnit: إطار الاختبارات الأساسي -->
		<PackageReference Include="xunit" Version="2.9.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<!-- Microsoft Test SDK: مطلوب لتشغيل dotnet test -->
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />

		<!-- FluentValidation TestHelper: يوفر ShouldHaveValidationErrorFor -->
		<PackageReference Include="FluentValidation.TestHelper" Version="11.9.2" />

		<!-- Moq: للـ Mocking (مستقبلاً) -->
		<PackageReference Include="Moq" Version="4.20.72" />

		<!-- تغطية الكود -->
		<PackageReference Include="coverlet.collector" Version="6.0.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<!-- ── مراجع المشاريع التي نختبرها ─────────────────────── -->
	<ItemGroup>
		<ProjectReference Include="..\PropertyApi.Application\PropertyApi.Application.csproj" />
		<ProjectReference Include="..\PropertyApi.Domain\PropertyApi.Domain.csproj" />
	</ItemGroup>

</Project>