# ──────────────────────────────────────────────────────────────
# PropertyApi — .gitignore
# تاريخ التحديث: يونيو 2025 (مرحلة Stabilization)
# ──────────────────────────────────────────────────────────────

# .NET build outputs
bin/
obj/
[Bb]uild/
[Dd]ebug/
[Rr]elease/
artifacts/
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml

# IDE files
.vs/
.vscode/*
!.vscode/extensions.json
*.user
*.suo
*.rsuser
*.DotSettings.user

# JetBrains Rider
.idea/

# OS files
.DS_Store
Thumbs.db

# ASP.NET local / environment-specific config
**/Properties/launchSettings.json
**/*.Development.json
**/*.Local.json
**/*.local.json
**/*.Production.json
**/*.Staging.json

# Secrets — لا تُودَع أبداً في git
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
secrets.json
appsettings.Production.json
appsettings.Staging.json

# Publish profiles
**/Properties/PublishProfiles/*.pubxml
**/Properties/PublishProfiles/*.pubxml.user

# Temporary / legacy
Temp/
temp/
Legacy/
legacy/
PropertyApi/Legacy/    # ← مُضاف في Stabilization
*.bak
*.backup
*.tmp
*.log

# Runtime uploads — لا صور ولا مستندات مرفوعة في git
**/wwwroot/bilder/
**/wwwroot/profile_fotos/
**/wwwroot/uploads/
PropertyApi/wwwroot/bilder/    # ← مُضاف في Stabilization
PropertyApi/wwwroot/profile_fotos/

# Docker local overrides
compose.override.yml
docker-compose.override.yml