FROM postgis/postgis:17-3.5

# BUG (found via Database Backup run #583 investigation, 2026-09-12): this
# image's base OS is Debian 11 "bullseye", which is now "oldoldstable" --
# its dedicated bullseye-security suite has stopped publishing a
# freshly-dated Release file (confirmed: apt-get update failed with
# "Release file for .../bullseye-security/InRelease is expired (invalid
# since 4d...)", breaking every scheduled backup run since ~2026-09-08).
# bullseye main and bullseye-updates are unaffected and still serve current,
# validly-dated Release files -- only the now-decommissioned -security
# suite is stale, so drop just that one apt source instead of disabling
# Release-date validation (which would also mask a *real* future expiry on
# a source we still rely on). None of the packages installed below are
# security-suite-exclusive. Revisit this once postgis/postgis publishes a
# 17-3.5 tag on a non-EOL Debian base.
#
# BUG (Production Gate run #487, 2026-10-02): the base image also ships a
# pgdg.list apt source (bullseye-pgdg, apt.postgresql.org) for installing
# PostgreSQL packages from PGDG -- but apt.postgresql.org has stopped
# serving that suite entirely (confirmed 404 on its Release file from two
# independent edge nodes, reproduced on two separate CI runs minutes
# apart, so this is PGDG dropping bullseye, not a transient mirror blip).
# We never actually install anything from pgdg here -- postgis/postgres
# binaries already come baked into the base image, and every package below
# is a plain Debian package -- so the fix is to drop that source too
# instead of waiting on an archive that is not coming back.
RUN find /etc/apt/sources.list /etc/apt/sources.list.d/ -type f 2>/dev/null \
      -exec sed -i -e '/bullseye-security/d' -e '/apt\.postgresql\.org/d' {} + \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        awscli \
        ca-certificates \
        curl \
        gnupg \
        jq \
        python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY scripts/database/ /workspace/scripts/database/
RUN chmod 0755 /workspace/scripts/database/*.sh \
    && mkdir -p /workspace/artifacts \
    && chown -R postgres:postgres /workspace

USER postgres
ENTRYPOINT []
CMD ["bash"]
