FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore tools/HudhudNestApi.Migrator/HudhudNestApi.Migrator.csproj --locked-mode
RUN dotnet publish tools/HudhudNestApi.Migrator/HudhudNestApi.Migrator.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
USER app
ENTRYPOINT ["dotnet", "HudhudNestApi.Migrator.dll"]
