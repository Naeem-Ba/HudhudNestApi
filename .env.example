# PropertyApi backend environment variables
# Do not commit real secrets. Copy this file to your local secret store or platform environment settings.

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7136;http://localhost:5010

# PostgreSQL / PostGIS
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=propertyapi_local;Username=postgres;Password=CHANGE_ME;Trust Server Certificate=true

# JWT
Jwt__Issuer=PropertyApi
Jwt__Audience=PropertyApiClient
Jwt__Key=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30

# OTP
OtpSettings__SecretKey=CHANGE_ME_USE_A_LONG_RANDOM_OTP_SECRET

# CORS
Cors__AllowedOrigins__0=https://localhost:4200
Cors__AllowedOrigins__1=http://localhost:4200

# Frontend links used by emails
Frontend__PasswordResetUrl=https://localhost:4200/auth/reset-password

# Cloudinary
Cloudinary__CloudName=CHANGE_ME
Cloudinary__ApiKey=CHANGE_ME
Cloudinary__ApiSecret=CHANGE_ME

# Email / SMTP
Email__From=no-reply@propertyapi.local
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__EnableSsl=true

# Swagger
# Keep false in Production unless protected by network/VPN/auth gateway.
Swagger__Enabled=false

# SignalR scaling
# Empty/default = in-memory. Use Redis when running more than one backend instance.
SignalR__Provider=
ConnectionStrings__SignalRRedis=
