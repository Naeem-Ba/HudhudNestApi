# PropertyApi backend environment variables
# Do not commit real secrets. Copy this file to your local secret store or platform environment settings.

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7136;http://localhost:5010

# PostgreSQL / PostGIS
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=propertyapi_local;Username=postgres;Password=CHANGE_ME;Trust Server Certificate=true

# JWT
Jwt__Issuer=PropertyApi
Jwt__Audience=PropertyApiClient
Jwt__Key=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30

# OTP
OtpSettings__SecretKey=CHANGE_ME_USE_A_LONG_RANDOM_OTP_SECRET

# CORS
Cors__AllowedOrigins__0=https://localhost:4200
Cors__AllowedOrigins__1=http://localhost:4200

# Frontend links used by emails
Frontend__PasswordResetUrl=https://localhost:4200/auth/reset-password

# Cloudinary
Cloudinary__CloudName=CHANGE_ME
Cloudinary__ApiKey=CHANGE_ME
Cloudinary__ApiSecret=CHANGE_ME

# Email / SMTP
Email__From=no-reply@propertyapi.local
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__EnableSsl=true

# Swagger
# Keep false in Production unless protected by network/VPN/auth gateway.
Swagger__Enabled=false

# SignalR scaling
# Empty/default = in-memory. Use Redis when running more than one backend instance.
SignalR__Provider=
ConnectionStrings__SignalRRedis=
# OpenTelemetry (required in Production; keep values in the deployment secret store)
Observability__Enabled=true
Observability__ServiceName=property-api
Observability__ServiceNamespace=yaqeen-real-estate
Observability__ServiceVersion=
Observability__Environment=Production
Observability__GitCommitSha=
Observability__Otlp__Endpoint=https://otel-collector.example.invalid:4317
Observability__Otlp__Protocol=grpc
Observability__Otlp__Headers=
Observability__Otlp__RequireAuthentication=true
Observability__Tracing__SamplingRatio=0.10

# Mandatory Staging release identity and isolation
# Set these only in isolated Staging. Production must never enable test support.
#
# Every key below is read by StagingEnvironmentGuard.Validate at startup and the
# app refuses to boot in Staging if one is missing. The names must match the
# guard exactly -- five of them were previously spelled differently here
# (PublicUrl / ProductionUrl / DatabaseMarker / RedisMarker / StorageMarker),
# so following this file literally produced a Staging boot failure.
Deployment__CommitSha=REPLACE_WITH_DEPLOYED_GIT_SHA
Deployment__Version=REPLACE_WITH_RELEASE_VERSION
# Must be absolute HTTPS, and a different host from ProductionBaseUrl.
Deployment__PublicBaseUrl=https://api-staging.example.com
Deployment__ProductionBaseUrl=https://api.example.com
Staging__EnvironmentId=propertyapi-staging
# Must appear inside the database name in ConnectionStrings__DefaultConnection.
Staging__DatabaseNameMarker=propertyapi_staging
Staging__RedisIsolationMarker=propertyapi-staging
Staging__StorageIsolationMarker=propertyapi-staging
Staging__ExternalNotificationsDisabled=true
Staging__TestSupport__Enabled=true
Staging__TestSupport__FixedOtp=CHANGE_ME_SIX_DIGITS
Staging__TestSupport__PhonePrefix=+1555000
Staging__TestSupport__CleanupSecret=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Isolated concurrent performance validation (never point at Production)
PERF_ENVIRONMENT=Local
PERF_PROFILE=pr
PERF_BASE_URL=http://localhost:58080
PRODUCTION_BASE_URL=https://api.example.com
PERF_DATASET_SIZE=10000
PERF_VIRTUAL_USERS=8
PERF_TEST_DURATION=20s
PERF_TEST_PHONE_PREFIX=+155590
# PERF_TEST_PASSWORD, PERF_FIXED_OTP and other runtime secrets are generated by the runner
# or supplied from a protected CI secret store. Do not commit their values.
