  "links": [],
  "panels": [
    { "id": 1, "title": "Request rate", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"property-api\"}[5m]))" }] },
    { "id": 2, "title": "p95 latency", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"property-api\"}[5m])))" }] },
    { "id": 3, "title": "p99 latency", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"property-api\"}[5m])))" }] },
    { "id": 4, "title": "5xx ratio", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"property-api\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"property-api\"}[5m])), 0.001)" }] },
    { "id": 5, "title": "Authentication failures", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (operation) (rate(propertyapi_auth_requests_total{outcome!=\"success\"}[5m]))" }] },
    { "id": 6, "title": "PostgreSQL dependency p95", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"property-api\",db_system_name=\"postgresql\"}[5m])))" }] },
    { "id": 7, "title": "Redis dependency p95", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"property-api\",db_system_name=\"redis\"}[5m])))" }] },
    { "id": 8, "title": "Outbound HTTP dependency p95", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_client_request_duration_seconds_bucket{service_name=\"property-api\"}[5m])))" }] },
    { "id": 9, "title": "Process working set", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "process_memory_working_set_bytes{service_name=\"property-api\"}" }] },
    { "id": 10, "title": "Collector export failures", "type": "timeseries", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "sum(rate(otelcol_exporter_send_failed_spans[5m])) + sum(rate(otelcol_exporter_send_failed_metric_points[5m]))" }] },
    { "id": 11, "title": "Availability SLI", "type": "stat", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "propertyapi:sli_availability:ratio_rate5m" }] },
    { "id": 12, "title": "Error budget remaining", "type": "stat", "datasource": { "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "propertyapi:slo_availability:error_budget_remaining" }] }
  ],
